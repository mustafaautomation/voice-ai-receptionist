# Local demo settings. Copy to .env and replace the webhook secret.
# Nothing in this file is a real credential.

PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# sqlite (default) or memory. Use calcom only with the keys below.
DATABASE_PATH=./data/clinic.sqlite
CALENDAR_PROVIDER=sqlite
SEED_ON_BOOT=true

# Shared secret Vapi sends in the x-vapi-secret header.
VAPI_WEBHOOK_SECRET=replace-with-a-long-random-string
# Private key used only by `npm run vapi:sync`. Leave empty for a dry run.
VAPI_API_KEY=
# Public URL Vapi can reach (tunnel or host). Tool URLs are built from this.
PUBLIC_BASE_URL=http://localhost:3000

# memory (default, stores the push result locally), webhook, or ghl-stub.
CRM_PROVIDER=memory
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Optional Cal.com adapter. Ignored unless CALENDAR_PROVIDER=calcom.
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_API_BASE=https://api.cal.com

# Fictional front-desk number returned by transfer_to_human.
TRANSFER_NUMBER=+13125550199

# Optional. `npm run eval:live` only. CI does not need this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
