# Local demo settings. Copy to .env and replace the webhook secret.
# Nothing in this file is a real credential.

PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# sqlite (default), memory, or relay. Use calcom only with the keys below.
DATABASE_PATH=./data/clinic.sqlite
CALENDAR_PROVIDER=sqlite
SEED_ON_BOOT=true
# false on Vercel, where the CDN serves public/.
SERVE_STATIC=true

# Only for CALENDAR_PROVIDER=relay (remote document store with atomic reserve).
RELAY_URL=
RELAY_TOKEN=
RELAY_NAMESPACE=brightside

# Shared secret Vapi sends in the x-vapi-secret header.
VAPI_WEBHOOK_SECRET=replace-with-a-long-random-string
# Private key for `npm run vapi:sync` and for signing browser call tokens. Leave empty for a dry run.
VAPI_API_KEY=
# Browser calls: the server signs a short-lived token per call (needs VAPI_API_KEY too).
VAPI_ORG_ID=
# Fallback when the private key is not on the server: handed out after the limit check.
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
# Comma-separated origins allowed to start calls. Defaults to PUBLIC_BASE_URL.
WEB_CALL_ORIGINS=
WEB_CALL_LIMIT_PER_VISITOR=3
WEB_CALL_LIMIT_PER_DAY=40
WEB_CALL_TOKEN_TTL_SECONDS=30
# true only behind a proxy that sets x-real-ip / x-forwarded-for (Vercel).
TRUST_PROXY_HEADERS=false
# Public URL Vapi can reach (tunnel or host). Tool URLs are built from this.
PUBLIC_BASE_URL=http://localhost:3000

# memory (default, stores the push result locally), webhook, or ghl-stub.
CRM_PROVIDER=memory
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Optional Cal.com adapter. Ignored unless CALENDAR_PROVIDER=calcom.
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_API_BASE=https://api.cal.com

# Fictional front-desk number returned by transfer_to_human.
TRANSFER_NUMBER=+13125550199

# Optional. `npm run eval:live` only. CI does not need this.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
